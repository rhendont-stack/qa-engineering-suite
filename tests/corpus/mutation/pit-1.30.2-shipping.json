      "source": "package corpus;\n\npublic final class Shipping {\n    private Shipping() {\n    }\n\n    public static double cost(double weightKg, boolean express) {\n        if (weightKg <= 0) {\n            throw new IllegalArgumentException(\"weight must be positive\");\n        }\n        double cost = 5.0;\n        if (weightKg > 10) {\n            cost += (weightKg - 10) * 0.5;\n        }\n        if (express) {\n            cost *= 2;\n        }\n        return cost;\n    }\n}\n"
    }
