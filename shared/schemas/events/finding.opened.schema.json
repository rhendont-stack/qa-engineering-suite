{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "finding.opened event data",
  "description": "A finding record (Appendix A.3). Every key is present; absent optional text is null. refs also carries rule (the detecting rule, or manual) and location (the fingerprint's path plus an optional symbol), and key_attributes feeds the fingerprint.",
  "type": "object",
  "properties": {
    "id": {"$ref": "defs.schema.json#/$defs/fnd_id"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "category": {"$ref": "defs.schema.json#/$defs/category"},
    "severity": {"$ref": "defs.schema.json#/$defs/severity"},
    "severity_rationale": {"$ref": "#/$defs/severity_rationale"},
    "priority": {"$ref": "defs.schema.json#/$defs/priority"},
    "component": {"$ref": "#/$defs/component"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "reproduction_steps": {"type": "array", "items": {"type": "string"}},
    "impact": {"type": ["string", "null"]},
    "probable_cause": {"type": ["string", "null"]},
    "recommendation": {"type": ["string", "null"]},
    "verification_status": {"$ref": "defs.schema.json#/$defs/verification"},
    "state": {"$ref": "defs.schema.json#/$defs/finding_state"},
    "refs": {"$ref": "#/$defs/refs"},
    "links": {"$ref": "#/$defs/string_lists"},
    "source": {"$ref": "#/$defs/source"},
    "fingerprint": {"$ref": "defs.schema.json#/$defs/sha256"},
    "commit": {"type": ["string", "null"]},
    "key_attributes": {"type": "object"}
  },
  "required": [
    "id", "title", "description", "category", "severity", "severity_rationale", "priority", "component", "evidence",
    "reproduction_steps", "impact", "probable_cause", "recommendation", "verification_status", "state", "refs", "links",
    "source", "fingerprint", "commit", "key_attributes"
  ],
  "additionalProperties": false,
  "$defs": {
    "severity_rationale": {
      "type": "object",
      "properties": {
        "anchor": {"type": "string", "minLength": 1},
        "modifiers": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["anchor", "modifiers"],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1},
        "criticality": {"enum": ["critical", "high", "normal", "low"]},
        "criticality_source": {"const": "default"}
      },
      "required": ["criticality"],
      "additionalProperties": false
    },
    "refs": {
      "type": "object",
      "properties": {
        "cwe": {"type": "array", "items": {"type": "string"}},
        "owasp_api_2023": {"type": "array", "items": {"type": "string"}},
        "rule": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1}
      },
      "required": ["rule"],
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "string_lists": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "source": {
      "type": "object",
      "properties": {
        "skill": {"type": ["string", "null"]},
        "method": {"enum": ["static", "dynamic", "manual"]},
        "tool": {"type": "string"},
        "level": {"type": "string"},
        "security_severity": {"type": ["number", "null"]},
        "start_line": {"type": ["integer", "null"]},
        "uri": {"type": "string"}
      },
      "required": ["skill", "method"],
      "additionalProperties": false
    }
  }
}
