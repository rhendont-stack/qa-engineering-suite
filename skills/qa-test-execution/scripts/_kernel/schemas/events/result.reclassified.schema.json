{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "result.reclassified event data",
  "description": "A person or agent changed a result's status, within section 8.3's limits, citing evidence. The fold decides against the result's current status.",
  "type": "object",
  "properties": {
    "result": {"$ref": "defs.schema.json#/$defs/res_id"},
    "new_status": {"$ref": "defs.schema.json#/$defs/status"},
    "reason": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"anyOf": [{"$ref": "defs.schema.json#/$defs/ev_id"}, {"$ref": "defs.schema.json#/$defs/exe_id"}]}
    }
  },
  "required": ["result", "new_status", "reason", "evidence"],
  "additionalProperties": false
}
