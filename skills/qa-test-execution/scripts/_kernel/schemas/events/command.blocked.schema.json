{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "command.blocked event data",
  "description": "The command guard denied a command, with the rule that matched (section 12.3).",
  "type": "object",
  "properties": {
    "execution": {"$ref": "defs.schema.json#/$defs/exe_id"},
    "activity": {"$ref": "defs.schema.json#/$defs/activity"},
    "rule_id": {"type": "string"},
    "reason": {"type": "string"},
    "command": {
      "type": "object",
      "properties": {
        "argv": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "shell": {"type": "boolean"},
        "cwd": {"type": "string"}
      },
      "required": ["argv", "shell", "cwd"],
      "additionalProperties": false
    }
  },
  "required": ["execution", "activity", "rule_id", "reason", "command"],
  "additionalProperties": false
}
