# Generated by qa ci generate. On a clean runner this job re-runs, at commit $target_commit, the runs recorded
# locally, pins itself to the configuration accepted when it was generated, and uploads the evidence as one bundle.
# It computes no verdict: import the bundle with `qa ingest bundle` where the gate is evaluated.
name: $name

on:
  workflow_dispatch:
  push:
    paths:
      - ".github/workflows/$name.yml"

permissions: {}

jobs:
  reexecute:
    name: Re-run recorded commands
    runs-on: ubuntu-24.04
    timeout-minutes: $timeout_minutes
    permissions:
      contents: read
    concurrency:
      group: $name
      cancel-in-progress: false
    steps:
      - name: Check out the recorded commit
        uses: $checkout
        with:
          ref: $target_commit
          persist-credentials: false
      - name: Pin the workspace to the accepted configuration
        run: |
          $begin
${steps}      - name: Bundle the evidence
        if: $${{ !cancelled() }}
        run: |
          $bundle
      - name: Upload the evidence bundle
        if: $${{ !cancelled() }}
        uses: $upload_artifact
        with:
          name: qa-evidence-bundle
          path: $${{ runner.temp }}/qa-evidence-bundle.tar.gz
          retention-days: 7
          if-no-files-found: error
