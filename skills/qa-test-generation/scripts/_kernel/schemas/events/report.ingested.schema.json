{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "report.ingested event data",
  "description": "A report file attached to an existing execution. strength is structured only when the file matches that execution's intact manifest.",
  "type": "object",
  "properties": {
    "execution": {"$ref": "defs.schema.json#/$defs/exe_id"},
    "format": {"enum": ["junit", "ctrf", "sarif", "lcov", "cobertura", "jacoco", "mutation", "k6"]},
    "kind": {"enum": ["tests", "alerts", "coverage", "mutants"]},
    "total": {"type": "integer", "minimum": 0, "description": "cases, alerts, (coverage) files, or mutants"},
    "totals": {"$ref": "events/execution.recorded.schema.json#/$defs/measurement_totals"},
    "anomalies": {"type": "array", "items": {"enum": ["path_outside_project", "partial"]}, "minItems": 1, "description": "measurements only; absent when none"},
    "file": {"type": "string"},
    "sha256": {"$ref": "defs.schema.json#/$defs/sha256"},
    "ev_id": {"$ref": "defs.schema.json#/$defs/ev_id"},
    "strength": {"enum": ["structured", "attested"]},
    "category": {"$ref": "defs.schema.json#/$defs/category"}
  },
  "required": ["execution", "format", "kind", "total", "file", "sha256", "ev_id", "strength", "category"],
  "additionalProperties": false
}
